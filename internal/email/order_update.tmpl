<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">

<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <title>Order Update - Dicty Stock Center</title>

    <style type="text/css">
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen-Sans, Ubuntu, Cantarell, 'Helvetica Neue', sans-serif;
            font-size: 16px;
            line-height: 1.6;
            color: #1a1a1a;
            background-color: #f8f9fa;
            -webkit-font-smoothing: antialiased;
            -webkit-text-size-adjust: none;
            width: 100% !important;
            height: 100%;
        }

        .email-wrapper {
            padding: 20px 0;
        }

        .email-container {
            max-width: 60%;
            margin: 0 auto;
            background-color: #ffffff;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        }

        .header {
            background: linear-gradient(135deg, #1565C0 0%, #0D47A1 100%);
            padding: 32px 32px;
            text-align: center;
            position: relative;
        }

        .header::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, #42A5F5, #1E88E5, #1565C0);
        }

        .header h1 {
            font-size: 32px;
            font-weight: 600;
            margin: 0;
            color: #ffffff;
            letter-spacing: -0.5px;
        }

        .content {
            padding: 40px 40px;
        }

        .notification-badge {
            display: inline-block;
            padding: 8px 16px;
            background-color: #E3F2FD;
            color: #1565C0;
            font-size: 13px;
            font-weight: 600;
            border-radius: 20px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 24px;
        }

        .order-header {
            margin-bottom: 32px;
        }

        .order-title {
            font-size: 24px;
            font-weight: 700;
            color: #1a1a1a;
            margin-bottom: 8px;
            letter-spacing: -0.3px;
        }

        .order-id {
            font-size: 15px;
            color: #666666;
            font-weight: 500;
        }

        .order-id-value {
            color: #1565C0;
            font-weight: 600;
        }

        .status-card {
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            border-left: 4px solid #1565C0;
            padding: 24px;
            border-radius: 8px;
            margin-bottom: 32px;
        }

        .status-label {
            font-size: 13px;
            color: #666666;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            margin-bottom: 8px;
            font-weight: 600;
        }

        .status-value {
            font-size: 20px;
            font-weight: 700;
            color: #1565C0;
            letter-spacing: -0.2px;
        }

        .message-box {
            background-color: #f8f9fa;
            padding: 20px 24px;
            border-radius: 8px;
            margin-bottom: 32px;
            border: 1px solid #e9ecef;
        }

        .message-box p {
            margin: 0;
            color: #495057;
            font-size: 15px;
            line-height: 1.7;
        }

        .divider {
            height: 1px;
            background: linear-gradient(90deg, transparent, #dee2e6, transparent);
            margin: 32px 0;
        }

        .signature-section {
            margin-top: 32px;
        }

        .signature {
            line-height: 1.9;
            color: #495057;
            font-size: 15px;
        }

        .signature-title {
            font-weight: 600;
            color: #1a1a1a;
        }

        .contact-button {
            display: inline-block;
            margin-top: 20px;
            padding: 12px 28px;
            background-color: #1565C0;
            color: #ffffff !important;
            text-decoration: none;
            border-radius: 6px;
            font-weight: 600;
            font-size: 14px;
            transition: background-color 0.2s;
        }

        .contact-button:hover {
            background-color: #0D47A1;
        }

        .footer {
            background-color: #f8f9fa;
            padding: 32px;
            text-align: center;
            border-top: 1px solid #e9ecef;
        }

        .footer-text {
            font-size: 13px;
            color: #868e96;
            margin-bottom: 8px;
            line-height: 1.6;
        }

        .footer-links {
            margin-top: 16px;
        }

        .footer-link {
            color: #1565C0;
            text-decoration: none;
            font-size: 13px;
            font-weight: 500;
        }

        .footer-link:hover {
            text-decoration: underline;
        }

        .stock-section {
            margin-bottom: 32px;
        }

        .stock-title {
            font-size: 18px;
            font-weight: 700;
            color: #1a1a1a;
            margin-bottom: 16px;
            letter-spacing: -0.2px;
        }

        .stock-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
            background-color: #ffffff;
            border: 1px solid #e9ecef;
            border-radius: 8px;
            overflow: hidden;
        }

        .stock-table thead {
            background: linear-gradient(135deg, #1565C0 0%, #0D47A1 100%);
        }

        .stock-table th {
            padding: 14px 16px;
            text-align: left;
            font-size: 13px;
            font-weight: 600;
            color: #ffffff;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .stock-table tbody tr {
            border-bottom: 1px solid #f1f3f5;
        }

        .stock-table tbody tr:last-child {
            border-bottom: none;
        }

        .stock-table tbody tr:hover {
            background-color: #f8f9fa;
        }

        .stock-table td {
            padding: 14px 16px;
            font-size: 14px;
            color: #495057;
        }

        .stock-table th:first-child,
        .stock-table td:first-child {
            width: 40%;
            min-width: 140px;
            max-width: 140px;
        }

        .stock-id {
            font-weight: 600;
            color: #1565C0;
        }

        @media only screen and (max-width: 640px) {
            .email-wrapper {
                padding: 10px;
            }

            .email-container {
                border-radius: 8px;
            }

            .header {
                padding: 36px 24px;
            }

            .header h1 {
                font-size: 26px;
            }

            .content {
                padding: 24px 24px;
            }

            .order-title {
                font-size: 20px;
            }

            .status-value {
                font-size: 18px;
            }

            .status-card {
                padding: 20px;
            }

            .footer {
                padding: 24px 20px;
            }

            .stock-title {
                font-size: 16px;
            }

            .stock-table th,
            .stock-table td {
                padding: 12px;
                font-size: 13px;
            }
        }
    </style>
</head>

<body>
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="background-color: #f8f9fa;">
        <tr>
            <td align="center" class="email-wrapper">
                <div class="email-container">
                    <!-- Header -->
                    <div class="header">
                        <h1>Dicty Stock Center</h1>
                    </div>

                    <!-- Content -->
                    <div class="content">
                        <div class="order-header">
                            <div class="order-title">Your Order Has Been Updated</div>
                            <div class="order-id">
                                Order Number: <span class="order-id-value">{{.OrderID}}</span>
                            </div>
                        </div>

                        <div class="status-card">
                            <div class="status-label">Current Status</div>
                            <div class="status-value">{{.Label}}</div>
                        </div>

                        {{if .StockData.StrainInfo}}
                        <div class="stock-section">
                            <div class="stock-title">Strains Ordered</div>
                            <table class="stock-table" role="presentation" cellspacing="0" cellpadding="0">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Descriptor</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {{range .StockData.StrainInfo}}
                                    <tr>
                                        <td class="stock-id">{{.ID}}</td>
                                        <td>{{.Descriptor}}</td>
                                    </tr>
                                    {{end}}
                                </tbody>
                            </table>
                        </div>
                        {{end}}

                        {{if .StockData.PlasmidInfo}}
                        <div class="stock-section">
                            <div class="stock-title">Plasmids Ordered</div>
                            <table class="stock-table" role="presentation" cellspacing="0" cellpadding="0">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Name</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {{range .StockData.PlasmidInfo}}
                                    <tr>
                                        <td class="stock-id">{{.ID}}</td>
                                        <td>{{.Name}}</td>
                                    </tr>
                                    {{end}}
                                </tbody>
                            </table>
                        </div>
                        {{end}}

                        <div class="message-box">
                            <p>
                                We wanted to let you know that your order status has been updated.
                                If you have any questions or concerns about your order, please don't
                                hesitate to reach out to our team.
                            </p>
                        </div>

                        <div class="divider"></div>

                        <div class="signature-section">
                            <div class="signature">
                                <span class="signature-title">Best regards,</span><br>
                                The Dicty Stock Center Team<br>
                                Northwestern University
                            </div>
                            <a href="mailto:dictystocks@northwestern.edu" class="contact-button">Contact Us</a>
                        </div>
                    </div>

                    <!-- Footer -->
                    <div class="footer">
                        <div class="footer-text">
                            Dicty Stock Center &bull; Northwestern University<br>
                            This is an automated notification about your order.
                        </div>
                        <div class="footer-links">
                            <a href="mailto:dictystocks@northwestern.edu" class="footer-link">dictystocks@northwestern.edu</a>
                        </div>
                    </div>
                </div>
            </td>
        </tr>
    </table>
</body>

</html>
